import numpy as np

# Define separate 1D arrays for product attributes (1D Arrays Approach)
product_ids = np.array([101, 102, 103, 104, 105])
prices = np.array([250.0, 45.5, 120.0, 89.9, 550.0])
stock = np.array([15, 85, 3, 0, 8])
units_sold = np.array([120, 340, 50, 210, 15])

# 1. Calculate the total monetary value of available stock for each product
product_values = prices * stock

# 2. Identify low-stock products using boolean masking (Stock < 5)
low_stock_mask = stock < 5
critical_products = product_ids[low_stock_mask]

# 3. Filter high-performing products using compound conditions (Units_Sold > 100 AND Price > 50)
high_perf_mask = (units_sold > 100) & (prices > 50)
top_selling_products = product_ids[high_perf_mask]

# 4. Generate and print the final structured inventory report
print("=== INVENTORY ANALYSIS REPORT ===")
print(f"Total Value of Stock: ${np.sum(product_values):.2f}")
print(f"Average Product Price: ${np.mean(prices):.2f}")
print(f"Critical Stock Alert (IDs): {critical_products}")
print(f"Top Performing Products (IDs): {top_selling_products}")
