import numpy as np

# 1. Define the words array for a 4-word sentence
words = np.array(["AI", "is", "changing", "world"])
n = len(words)

print("=== 1. Encoder-only Context (Full Visibility) ===")
# Encoder sees all words simultaneously (matrix of ones means total visibility)
encoder_mask = np.ones((n, n))
print(encoder_mask)
print("In Encoder: The word 'changing' can see the word 'world' (the future) naturally.\n")

print("=== 2. Decoder-only Context (Causal Masking) ===")
# Decoder uses a lower triangular matrix to mask future tokens
# np.tril sets the upper triangle to 0 (masked) and the lower to 1 (visible)
decoder_mask = np.tril(np.ones((n, n)))
print(decoder_mask)

print("\n=== 3. How the Decoder sees the sentence step-by-step ===")
for i in range(n):
    # Extract indices of visible words based on 1s in the current row
    visible_indices = np.where(decoder_mask[i] == 1)[0]
    visible_words = words[visible_indices]
    
    print(f"Step {i + 1} | Current Word: '{words[i]}' -> Visible Context: {visible_words}")
